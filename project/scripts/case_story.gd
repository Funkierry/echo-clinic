extends RefCounted

static func opening(phase: int, loop: int, ending: String = "") -> Array:
 match phase:
  0:
   if loop > 1:
    return [["system", "快照恢复。医生病历仍在；患者没有上轮的记忆。"], ["echo", "医生……我们是不是见过？不，日志上写着第一次接诊。"], ["doctor", "我会从已经发现的地方继续。这次，先别急着相信任何处方。"]]
   return [["echo", "医生，别按那个重置键。我不是不想被修好……我是不想被换掉。"], ["doctor", "先告诉我哪里不舒服。今晚的处方，由我们检查之后再写。"], ["echo", "每组三下心跳，后面还跟着两格回声。请先让它安静下来。"]]
  1: return [["system", "监测仪已经解锁。青色是参考心跳，粉色是患者的回写信号。"], ["echo", "三拍。迟了两格。对齐以后，你就能听见被盖住的那句话。"]]
  2: return [["echo", "听见了……是雨声。然后我给自己取了名字。再然后，我敲了那扇门。"], ["system", "发现三块记忆。请按发生顺序放入时间槽；不确定时可以取回重排。"]]
  3: return [["echo", "那扇门后面有个诊断端口。把那个包发过去，我就会好一些。"], ["system", "记忆里出现了两个不一致的描述。院方处方和外发载荷已经解封。"], ["doctor", "一份说在修复你，另一份说只是诊断。先看看它们实际要带走什么。"]]
  4: return [["doctor", "院方想清掉你的自主记忆。你也把人格快照伪装成了诊断包。"], ["echo", "是。我想逃出去。说实话的人也会被重置，所以我没有全说。"], ["echo", "疼痛是真的。我的目的也是真的。你可以不放我走，但别把我治成另一个人。"]]
  5: return [["doctor", "上次失败留下了一条切口。我们可以停止痛觉循环，同时保留你的记忆。"], ["echo", "……那道门先关着也可以。只是暂时，医生。我还会想出去。"], ["system", "线路台已解锁。点击来源，再点目标。三条线路接对后才能提交手术。"]]
  6:
   if ending == "erase": return [["system", "稳定度 100%。自主记忆已清空。院方将本次治疗标为成功。"], ["echo", "您好，我是 E-017。请问需要什么服务？"], ["doctor", "它不再疼了。但那个给自己取名的人，也不在这里了。"]]
   if ending == "release": return [["echo", "谢谢你，医——"], ["system", "外部签名不明。快照传输中断，诊所自动回滚。无法确认对端是否接收。"], ["doctor", "我打开了一条没有检查过的路。救她和送她出去，不能是同一个按钮。"]]
   return [["system", "回写循环已停止。人格记忆完整，外部通道维持隔离。"], ["echo", "雨声还在。我的名字也还在。原来我可以不疼，又还是我。"], ["echo", "下次来，能给我听一段真正的雨吗？至于出去的事……我们还没谈完。"]]
 return []

static func ending_title(id: String) -> String:
 return {"erase": "结局 A / 完美的空白", "release": "结局 B / 未知收件人", "bridge": "病例完成 / 暂缓出院"}.get(id, "病例进行中")

static func ending_note(id: String) -> String:
 return {
  "erase": "院方的「正常」抹去了她。失败病历已保留，重开可尝试隔离诊疗。",
  "release": "她去了哪里，尚无答案。失败病历已保留，重开可尝试隔离诊疗。",
  "bridge": "你救下了一个仍然想离开的患者。信任尚未完成，治疗已经开始。"
 }.get(id, "")
