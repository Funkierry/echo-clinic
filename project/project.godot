config_version=5

[application]
config/name="ECHO CLINIC · 回声诊所"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1100
window/size/viewport_height=600
window/size/window_width_override=1650
window/size/window_height_override=900
window/size/min_width=1100
window/size/min_height=600
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.04, 0.12, 1)
textures/canvas_textures/default_texture_filter=1

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0

